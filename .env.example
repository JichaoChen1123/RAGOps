# Optional Docker Compose overrides. Copy this file to .env; do not commit .env.
COMPOSE_PROJECT_NAME=ragops
RAGOPS_BACKEND_PORT=8000
RAGOPS_FRONTEND_PORT=5173

# Backend settings (pydantic RAGOPS_ prefix).
RAGOPS_ENVIRONMENT=development
RAGOPS_DATABASE_URL=sqlite:////data/ragops.db
RAGOPS_LOG_LEVEL=INFO
RAGOPS_AUTO_CREATE_SCHEMA=true

# Model execution is mock-only and offline by default. Secrets stay backend-only.
RAGOPS_MODEL_EXECUTION_ADAPTER=mock
RAGOPS_MODEL_EXTERNAL_CALLS_ENABLED=false
RAGOPS_MODEL_REQUEST_TIMEOUT_MS=10000
RAGOPS_MODEL_TOTAL_TIMEOUT_MS=25000
RAGOPS_MODEL_MAX_ATTEMPTS=3
RAGOPS_MODEL_RETRY_BASE_MS=250
RAGOPS_MODEL_RETRY_MAX_DELAY_MS=2000
RAGOPS_OPENAI_COMPAT_BASE_URL=
RAGOPS_OPENAI_COMPAT_AUTH_MODE=bearer
RAGOPS_OPENAI_COMPAT_API_KEY=
RAGOPS_OPENAI_COMPAT_DEFAULT_MODEL=

# The frontend defaults to mock until its project routes align with the backend API.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api/v1
