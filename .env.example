# Optional Docker Compose overrides. Copy this file to .env; do not commit .env.
COMPOSE_PROJECT_NAME=ragops
RAGOPS_BACKEND_PORT=8000
RAGOPS_FRONTEND_PORT=5173

# Backend settings (pydantic RAGOPS_ prefix).
RAGOPS_ENVIRONMENT=development
RAGOPS_DATABASE_URL=sqlite:////data/ragops.db
RAGOPS_LOG_LEVEL=INFO
RAGOPS_AUTO_CREATE_SCHEMA=true

# Model execution is mock-only and offline by default. Secrets stay backend-only.
RAGOPS_MODEL_EXECUTION_ADAPTER=mock
RAGOPS_MODEL_EXTERNAL_CALLS_ENABLED=false
RAGOPS_MODEL_REQUEST_TIMEOUT_MS=10000
RAGOPS_MODEL_TOTAL_TIMEOUT_MS=25000
RAGOPS_MODEL_MAX_ATTEMPTS=3
RAGOPS_MODEL_RETRY_BASE_MS=250
RAGOPS_MODEL_RETRY_MAX_DELAY_MS=2000

# ChatGPT account channel. Run scripts/manage_codex_bridge_login.ps1 once, then
# scripts/start_codex_bridge.ps1 on the Windows host. Authentication is kept in a
# dedicated local Codex home and is never copied into this file or a container.
# The bridge token is an app-local random secret, not a ChatGPT/OpenAI credential.
# Generate at least 32 random characters; short or blank values are rejected.
RAGOPS_CODEX_BRIDGE_URL=
RAGOPS_CODEX_BRIDGE_TOKEN=
RAGOPS_CODEX_DEFAULT_MODEL=

# OpenAI-compatible Chat Completions. Base URL is the API root, usually ending in /v1.
RAGOPS_OPENAI_COMPAT_PROVIDER_NAME=OpenAI-compatible provider
RAGOPS_OPENAI_COMPAT_BASE_URL=
RAGOPS_OPENAI_COMPAT_AUTH_MODE=bearer
RAGOPS_OPENAI_COMPAT_API_KEY=
RAGOPS_OPENAI_COMPAT_DEFAULT_MODEL=

# The frontend defaults to mock so a fresh clone cannot mistake fixtures for persisted API data.
# API mode is aligned with the backend resource routes but does not imply a model connection.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api/v1
